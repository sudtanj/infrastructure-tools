# Copy to .env next to the compose file.

# Required: bearer token for the setup page and the HTTP API (12+ characters).
# Generate with: openssl rand -hex 24
DENGAI_API_TOKEN=

# First login: leave the Steam variables empty, open http://127.0.0.1:8737/ (SSH tunnel or
# Tailscale) and sign in there. A shared_secret entered on the page makes re-logins unattended.
# Headless use only, not recommended (credentials end up in this file or your secrets):
# DENGAI_USERNAME=
# DENGAI_PASSWORD=
# DENGAI_SHARED_SECRET=   base64 shared_secret from your authenticator's maFile
# DENGAI_GUARD_CODE=      one-off Steam Guard code

# Optional tuning (defaults shown in the README).
# DENGAI_CLAIMS_PER_HOUR=30
# DENGAI_SKIP_DEMOS=false
# DENGAI_SKIP_PLAYTESTS=false
# DENGAI_COUNTRY=ID
# DENGAI_LOG=info
# Optional: auto-claim free apps (a/<id>) too, not only packages (default true).
# DENGAI_AUTO_CLAIM_APPS=true
# Optional: list of free sub/<id> / a/<id> to check and queue on the first start
# (plain text or JSON array; empty = off). Every id still goes through the PICS filter.
# DENGAI_BACKFILL_URL=https://gist.githubusercontent.com/C4illin/e8c5cf365d816f2640242bf01d8d3675/raw/Steam%20Codes
# Optional: seconds between backfills (default 0 = only once).
# DENGAI_BACKFILL_INTERVAL_SECS=86400
