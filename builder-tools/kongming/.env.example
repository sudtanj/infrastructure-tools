KONGMING_TURSO_DATABASE_URL=libsql://<db>-<org>.turso.io
KONGMING_TURSO_AUTH_TOKEN=
KONGMING_PASSWORD=change-me
KONGMING_SECRET=some-long-random-string
# Only when kongming is reachable at a public HTTPS address (MCP OAuth redirects,
# Telegram webhook). Leave unset behind a firewall.
# KONGMING_PUBLIC_URL=https://kongming.example.ts.net
# The LLM provider and the Telegram bot are set up in the dashboard after the first login.
