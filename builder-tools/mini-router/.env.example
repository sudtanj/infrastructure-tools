# Copy to .env and fill in what you have.
#
#   cp .env.example .env
#   docker compose -f docker-compose.hub.yml up -d
#
# This file holds secrets. Structure -- which pools exist, in what order --
# lives in the compose file, because a pool can only name providers you
# actually have a key for.

# --- Providers you have an account with --------------------------------------
# A key on its own is enough: mini-router already knows each one's URL and
# which dialect it speaks. Leave the rest blank.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
TOGETHER_API_KEY=
XAI_API_KEY=
GEMINI_API_KEY=
CEREBRAS_API_KEY=

# --- The key YOUR apps send to mini-router -----------------------------------
# Not a provider key. You invent this one; mini-router checks it and then
# replaces it with the provider's own key on the way out, so a client never
# holds a provider credential.
#
# Generate one:  openssl rand -hex 32
# Comma-separated for several, one per device, so you can revoke just one.
# Required: the compose file refuses to start without it.
MINI_ROUTER_API_KEYS=

# --- A custom provider: a proxy, a gateway, a self-hosted box ----------------
# Your own LiteLLM/vLLM box, a corporate gateway, an Azure deployment.
#
# Fill in all three or leave all three blank. A half-filled provider stops
# mini-router from starting with: provider "myproxy" needs a URL
#
# MYPROXY is only the example name used in the compose file -- it has to match
# the MINI_ROUTER_PROVIDER_<NAME>_* variables there, and it is the name you
# reference in a pool (myproxy:some-model).
#
# Filling these in switches off autodetection of the keys above, so set
# MINI_ROUTER_AUTODETECT=true in the compose file if you want both.
MYPROXY_URL=
MYPROXY_PROTOCOL=
MYPROXY_API_KEY=
