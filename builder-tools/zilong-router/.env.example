# Copy to .env next to the compose file. Everything is optional.

# Dashboard password until you change it in Settings (9router default: 123456).
INITIAL_PASSWORD=change-me

# Offsite database on Turso (https://turso.tech, free tier). Leave empty to keep
# the SQLite file in the volume instead.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# 1 = no database file at all: SQLite in RAM, Turso is the only durable copy.
TURSO_ONLY=0

# Sign dashboard sessions with a fixed secret (otherwise generated and kept in /data,
# or derived from TURSO_AUTH_TOKEN when TURSO_ONLY=1).
JWT_SECRET=
