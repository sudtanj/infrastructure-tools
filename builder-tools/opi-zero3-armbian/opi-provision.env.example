# Copy to opi-provision.env, fill in, and write it to /boot/opi-provision.env on the flashed SD
# card (see README.md). It is read once on boot and shredded; never commit the filled-in copy.

# Required: the only login of the device (sudo with this password). Use the same values as the
# OPI_SSH_USER / OPI_SSH_PASSWORD repo secrets so the Orange Pi workflow can log in.
OPI_SSH_USER=
OPI_SSH_PASSWORD=
# Optional: public keys, several separated by a literal \n
OPI_SSH_AUTHORIZED_KEYS=

OPI_HOSTNAME=orangepizero3
OPI_TIMEZONE=Asia/Jakarta

# Optional Wi-Fi (Ethernet always uses DHCP)
WIFI_SSID=
WIFI_PASSWORD=
WIFI_COUNTRY=ID

# Optional: join the tailnet on first boot with opi-init-tailscale-docker.sh, so the Orange Pi
# workflow can reach the device right away. Same values as the repo secrets of the same names.
TAILSCALE_OAUTH_CLIENT_SECRET=
OPI_TS_TAGS=
OPI_TS_IP=
OPI_TS_ROUTES=
