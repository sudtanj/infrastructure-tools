# Copy this file to .env and fill in what you need, then reference it from
# docker-compose.yml (already wired up via `env_file: .env`).

# --- Paseo itself --------------------------------------------------------
# Strongly recommended for any published port / network-reachable
# deployment - without it, the daemon accepts unauthenticated control
# connections from anyone who can reach it.
PASEO_PASSWORD=

# Optional. Defaults shown - only set if you need to change them.
# With network_mode: host (the compose default here), this is the actual
# host port the daemon binds to directly - change it if 6767 is taken.
# PASEO_LISTEN=0.0.0.0:6767
# Comma-separated DNS names you reach this container by (behind a reverse
# proxy, say) - IPs and localhost are already allowed by default. Without
# this, Paseo rejects the request with "403 Host not allowed".
# PASEO_HOSTNAMES=paseo.example.com,.lan

# --- Codex --------------------------------------------------------------
# Direct OpenAI API - Paseo passes this straight through to Codex sessions
# it launches.
OPENAI_API_KEY=

# Codex BYOK: point Codex at your own OpenAI-Responses-API-compatible
# endpoint instead of api.openai.com. Independent of OPENAI_API_KEY above -
# set this instead if you're not using OpenAI's own API.
#
# CODEX_API_KEY is optional (a local/trusted gateway needs no key at all,
# and omitting it sends no auth header). CODEX_MODEL is optional too - sets
# the default model Codex uses.
#
# Note: Codex CLI only speaks the newer Responses API (/v1/responses), not
# the more common Chat Completions format most third-party
# "OpenAI-compatible" gateways implement - your endpoint has to actually
# support it, or requests will fail even though Codex starts fine.
# CODEX_BASE_URL=
# CODEX_API_KEY=
# CODEX_MODEL=

# --- GitHub CLI (gh) ------------------------------------------------------
# Set this to clone/pull private repos into /workspace - a personal access
# token (repo scope) or a fine-grained token with contents:read is enough.
# Wired up automatically at container start for both `gh` subcommands and
# plain `git clone`/`git pull` (via `gh auth setup-git`). GITHUB_TOKEN also
# works as a fallback name if you already set that elsewhere.
# GH_TOKEN=
