# Copy this file to .env and fill in what you need, then reference it from
# docker-compose.yml (already wired up via `env_file: .env`).
#
# This drives https://github.com/mohankumarpaluru/oracle-freetier-instance-creation's
# main.py directly (not its own setup_init.sh/setup_env.sh flow) - every
# var below maps straight to one main.py reads via os.getenv(), except the
# OCI_USER_OCID/OCI_FINGERPRINT/OCI_TENANCY_OCID/OCI_REGION/OCI_PRIVATE_KEY*
# ones, which entrypoint.sh uses to generate the oci_config ini file +
# private key PEM that main.py expects (upstream normally has you create
# these by hand - see its README/sample_oci_config for where to get each
# value from your OCI console).

# --- OCI API credentials ---------------------------------------------------
# From OCI Console -> Profile -> My profile -> API keys -> Add API key.
OCI_USER_OCID=
OCI_FINGERPRINT=
OCI_TENANCY_OCID=
# e.g. ap-hyderabad-1, us-ashburn-1, ...
OCI_REGION=

# The private key half of that API key pair, PEM format. Set exactly ONE
# of these two:
# - Easiest/safest for a .env file - no newline-escaping to worry about:
#     base64 -w0 oci_api_private_key.pem
OCI_PRIVATE_KEY_BASE64=
# - Or paste the raw PEM with real newlines replaced by literal \n:
# OCI_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMII...\n-----END PRIVATE KEY-----

# --- Instance placement -----------------------------------------------------
# Required. Your tenancy's eligible Availability Domain for always-free
# resources - find it via `oci iam availability-domain list` or the OCI
# console (Governance & Administration -> Tenancy details).
OCT_FREE_AD=

# Required when running locally/in a container (per upstream's README) -
# an existing subnet OCID in the compartment/VCN you want the instance in.
OCI_SUBNET_ID=

# --- Optional instance settings (defaults shown are main.py's own) --------
# DISPLAY_NAME=my-arm-instance
# How often (seconds) to retry while capacity is exhausted.
# REQUEST_WAIT_TIME_SECS=60
# The other free shape is the AMD one: VM.Standard.E2.1.Micro
# OCI_COMPUTE_SHAPE=VM.Standard.A1.Flex
# SECOND_MICRO_INSTANCE=False
# OCI_IMAGE_ID=
# Ignored if OCI_IMAGE_ID is set.
# OPERATING_SYSTEM=Canonical Ubuntu
# OS_VERSION=22.04
# ASSIGN_PUBLIC_IP=false
# Minimum is 50.
# BOOT_VOLUME_SIZE=50

# --- SSH access to the created instance ------------------------------------
# main.py auto-generates a keypair on first run if you don't provide one -
# persisted in the oci-data volume either way, so it survives restarts.
# Set this only if you want to use your OWN existing public key instead:
# SSH_PUBLIC_KEY=ssh-ed25519 AAAA... you@example.com

# --- Notifications (both optional, both sent directly by main.py) ---------
# Gmail - EMAIL_PASSWORD is a 16-character Gmail "app password", not your
# normal account password (Google Account -> Security -> App passwords).
# NOTIFY_EMAIL=False
# EMAIL=you@gmail.com
# EMAIL_PASSWORD=

# DISCORD_WEBHOOK=https://discord.com/api/webhooks/...

# Note: upstream's README also documents TELEGRAM_TOKEN/TELEGRAM_USER_ID,
# but those are only implemented in setup_init.sh's own bash notification
# wrapper - this image runs main.py directly, which only ever sends Discord
# and (if NOTIFY_EMAIL=True) Gmail notifications itself.
