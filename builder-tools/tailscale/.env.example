# Tailscale auth key (admin console -> Settings -> Keys). Only used for the
# first login; after that the node key lives in the state volume. A reusable,
# pre-approved key tagged for servers is the easiest. Never commit the
# filled-in .env.
TS_AUTHKEY=tskey-auth-xxxx
# Name in the admin console and MagicDNS.
TS_HOSTNAME=opi-zero3
# true or false (JSON booleans, not 1/0). Needs IP forwarding on the host and
# approval in the admin console; see README.md.
TS_EXIT_NODE=true
# Fixed WireGuard UDP port, so a router port forward can give direct
# connections instead of DERP relays.
TS_PORT=41641
