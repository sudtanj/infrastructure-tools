# Set these in the Botkeep workload environment (never commit real values).
# Apply with: BOTKEEP_API_KEY=... WORKLOAD_ID=... ./scripts/set-env.sh .env
N8N_HOST=0.0.0.0
# Port: the start script uses the port Botkeep assigns (SERVER_PORT) and falls back to this
N8N_PORT=5678
N8N_PROTOCOL=https
# Public URL Botkeep gives the workload (needed for webhooks / OAuth callbacks)
WEBHOOK_URL=https://YOUR-WORKLOAD-DOMAIN/
# Generate with: openssl rand -hex 32  (keep it stable, it encrypts stored credentials)
N8N_ENCRYPTION_KEY=
# Keep the workload small
N8N_DIAGNOSTICS_ENABLED=false
N8N_VERSION_NOTIFICATIONS_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=72
# Heap cap is set in the start script (N8N_HEAP_MB, default 512); raise it if you have more RAM
N8N_HEAP_MB=512
GENERIC_TIMEZONE=UTC
