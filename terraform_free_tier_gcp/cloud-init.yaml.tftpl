#cloud-config
# Container-Optimized OS (COS) Cloud-Init for Portainer CE + Tailscale (Host Networking)

write_files:
  # 1. Standalone Docker Compose runner script (escaped $$PWD for Terraform templatefile)
  - path: /var/lib/docker-compose/docker-compose
    permissions: "0755"
    owner: root:root
    content: |
      #!/bin/sh
      exec docker run --rm -i \
        -v /var/run/docker.sock:/var/run/docker.sock \
        -v "$$PWD:$$PWD" \
        -w "$$PWD" \
        docker/compose:1.29.2 "$$@"

  # 2. Store Portainer Password Hash securely on disk (quoted to prevent YAML syntax errors)
  - path: /var/lib/portainer/password.txt
    permissions: "0600"
    owner: root:root
    content: "${portainer_admin_password_hash}"

  # 3. Docker Compose Stack with Host Networking
  - path: /var/lib/services/docker-compose.yml
    permissions: "0644"
    owner: root:root
    content: |
      version: '3.8'
      services:
        tailscale:
          image: tailscale/tailscale:latest
          container_name: tailscale
          hostname: gcp-free-tier-vm
          network_mode: host
          environment:
            - TS_AUTHKEY=${tailscale_auth_key}
            - TS_STATE_DIR=/var/lib/tailscale
            - TS_USERSPACE=false
          volumes:
            - /var/lib/tailscale:/var/lib/tailscale
            - /dev/net/tun:/dev/net/tun
          cap_add:
            - NET_ADMIN
            - NET_RAW
          restart: always

        portainer:
          image: portainer/portainer-ce:latest
          container_name: portainer
          network_mode: host
          command: --admin-password-file /run/secrets/portainer_password
          restart: always
          volumes:
            - /var/run/docker.sock:/var/run/docker.sock
            - /var/lib/portainer/password.txt:/run/secrets/portainer_password:ro
            - portainer_data:/data

      volumes:
        portainer_data:

  # 4. Systemd service runner
  - path: /etc/systemd/system/containers.service
    permissions: "0644"
    owner: root:root
    content: |
      [Unit]
      Description=Portainer & Tailscale Docker Compose Service
      After=docker.service
      Requires=docker.service

      [Service]
      Type=oneshot
      RemainAfterExit=yes
      WorkingDirectory=/var/lib/services
      ExecStart=/usr/local/bin/docker-compose up -d
      ExecStop=/usr/local/bin/docker-compose down

      [Install]
      WantedBy=multi-user.target

runcmd:
  - ln -sf /var/lib/docker-compose/docker-compose /usr/local/bin/docker-compose
  - systemctl daemon-reload
  - systemctl enable containers.service
  - systemctl start containers.service