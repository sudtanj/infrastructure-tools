#cloud-config
# COS: CPU/RAM optimizations + Docker initialization (e2-micro, 1 GB RAM).

write_files:
  # Cap journald so logs don't eat RAM/disk
  - path: /etc/systemd/journald.conf.d/size.conf
    permissions: "0644"
    owner: root:root
    content: |
      [Journal]
      SystemMaxUse=50M
      RuntimeMaxUse=20M
      MaxRetentionSec=3day

bootcmd:
  # --- DNS64 ---
  - systemctl stop systemd-resolved || true
  - systemctl mask systemd-resolved || true
  - rm -f /etc/resolv.conf
  - printf "nameserver 2001:4860:4860::6464\nnameserver 2001:4860:4860::64\n" > /etc/resolv.conf
  - chmod 644 /etc/resolv.conf

  # --- Docker daemon ---
  - mkdir -p /etc/docker
  - |
    cat > /etc/docker/daemon.json <<'EOF'
    {
      "dns": ["2001:4860:4860::6464", "2001:4860:4860::64"],
      "dns-opts": ["timeout:2", "attempts:3"],
      "log-driver": "local",
      "log-opts": {
        "max-size": "5m",
        "max-file": "2"
      },
      "userland-proxy": false,
      "max-concurrent-downloads": 2,
      "max-concurrent-uploads": 2,
      "live-restore": true
    }
    EOF
  - systemctl restart docker || true

  # --- Stop non-essential background agents (best effort) ---
  # Proper fix: set instance metadata google-logging-enabled=false and
  # google-monitoring-enabled=false (see Terraform snippet).
  - systemctl stop fluent-bit.service 2>/dev/null || true
  - systemctl mask fluent-bit.service 2>/dev/null || true
  - systemctl stop node-problem-detector.service 2>/dev/null || true
  - systemctl mask node-problem-detector.service 2>/dev/null || true

  # --- BBR + TCP tuning ---
  - modprobe tcp_bbr 2>/dev/null || true
  - sysctl -w net.core.default_qdisc=fq 2>/dev/null || true
  - sysctl -w net.ipv4.tcp_congestion_control=bbr 2>/dev/null || true
  - sysctl -w net.core.rmem_max=16777216 2>/dev/null || true
  - sysctl -w net.core.wmem_max=16777216 2>/dev/null || true
  - sysctl -w net.ipv4.tcp_rmem="4096 87380 16777216" 2>/dev/null || true
  - sysctl -w net.ipv4.tcp_wmem="4096 65536 16777216" 2>/dev/null || true
  - sysctl -w net.ipv4.tcp_rto_min_us=5000 2>/dev/null || true
  - sysctl -w net.ipv4.tcp_slow_start_after_idle=0 2>/dev/null || true
  - sysctl -w net.ipv4.tcp_fastopen=3 2>/dev/null || true
  - sysctl -w net.ipv4.tcp_tw_reuse=1 2>/dev/null || true
  - sysctl -w net.ipv4.tcp_fin_timeout=15 2>/dev/null || true
  - sysctl -w net.ipv4.ip_local_port_range="1024 65000" 2>/dev/null || true
  - sysctl -w net.core.somaxconn=1024 2>/dev/null || true
  - sysctl -w net.ipv4.tcp_max_syn_backlog=1024 2>/dev/null || true
  - sysctl -w net.ipv4.ip_forward=1 2>/dev/null || true
  - sysctl -w net.ipv6.conf.all.forwarding=1 2>/dev/null || true

  # --- VM memory ---
  # (vm.overcommit_memory left at default so the kernel can refuse bad allocations)
  - sysctl -w vm.dirty_ratio=5 2>/dev/null || true
  - sysctl -w vm.dirty_background_ratio=1 2>/dev/null || true
  - sysctl -w vm.min_free_kbytes=16384 2>/dev/null || true
  - sysctl -w vm.vfs_cache_pressure=50 2>/dev/null || true

  # --- Transparent hugepages: only when apps ask (avoids bloat on 1 GB) ---
  - echo madvise > /sys/kernel/mm/transparent_hugepage/enabled 2>/dev/null || true
  - echo madvise > /sys/kernel/mm/transparent_hugepage/defrag 2>/dev/null || true

  # --- ZRAM (zstd, ~1 GB virtual; only uses RAM as it fills) ---
  - modprobe zram 2>/dev/null || true
  - swapoff /dev/zram0 2>/dev/null || true
  - echo 1 > /sys/block/zram0/reset 2>/dev/null || true
  - echo zstd > /sys/block/zram0/comp_algorithm 2>/dev/null || echo lz4 > /sys/block/zram0/comp_algorithm 2>/dev/null || true
  - echo 1073741824 > /sys/block/zram0/disksize 2>/dev/null || true
  - mkswap /dev/zram0 2>/dev/null || true
  - swapon -p 100 /dev/zram0 2>/dev/null || true
  - sysctl -w vm.swappiness=100 2>/dev/null || true
  - sysctl -w vm.page-cluster=0 2>/dev/null || true

runcmd:
  - sed -i -e '/^AddressFamily/d' /etc/ssh/sshd_config
  - systemctl reload sshd.service || true

  # --- Apply journald size limits ---
  - systemctl restart systemd-journald || true

  # --- Docker ---
  - systemctl enable docker.service
  - systemctl start docker.service
